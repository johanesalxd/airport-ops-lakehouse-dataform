config {
  type: "table",
  schema: dataform.projectConfig.vars.goldDataset,
  tags: ["gold", "quality"],
  description: "Counts of anomalies the pipeline caught and quarantined. Long format (issue, count) so the demo can show governance working while the pipeline stays green."
}

-- Negative passenger counts caught in bronze and dropped in silver.
SELECT 'negative_passenger_counts' AS issue, COUNT(*) AS issue_count
FROM ${ref("brz_passenger_flow")}
WHERE passenger_count < 0

UNION ALL

-- Baggage events referencing a flight that does not exist (orphans).
SELECT 'orphan_baggage_events' AS issue, COUNT(*) AS issue_count
FROM ${ref("brz_baggage_events")} AS b
WHERE NOT EXISTS (
  SELECT 1 FROM ${ref("slv_flights")} AS f WHERE f.flight_id = b.flight_id
)

UNION ALL

-- Gate double-bookings (same gate + same scheduled departure).
SELECT 'gate_double_bookings' AS issue, COUNT(*) AS issue_count
FROM (
  SELECT gate, scheduled_departure, COUNT(*) AS c
  FROM ${ref("brz_flight_schedules")}
  GROUP BY gate, scheduled_departure
  HAVING COUNT(*) > 1
)

UNION ALL

-- Bags missing a load scan.
SELECT 'bags_missing_load_scan' AS issue, COUNT(*) AS issue_count
FROM ${ref("slv_baggage_journey")}
WHERE has_missing_load_scan

UNION ALL

-- Extreme security waits (>= 60 min).
SELECT 'extreme_security_waits' AS issue, COUNT(*) AS issue_count
FROM ${ref("brz_security_wait")}
WHERE wait_minutes >= 60
