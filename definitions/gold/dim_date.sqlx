config {
  type: "table",
  schema: dataform.projectConfig.vars.goldDataset,
  tags: ["gold"],
  description: "Conformed date dimension (derived from observed flight dates)."
}

SELECT DISTINCT
  flight_date AS date_key,
  EXTRACT(YEAR FROM flight_date) AS year,
  EXTRACT(MONTH FROM flight_date) AS month,
  EXTRACT(DAY FROM flight_date) AS day,
  FORMAT_DATE('%A', flight_date) AS day_of_week,
  IF(EXTRACT(DAYOFWEEK FROM flight_date) IN (1, 7), TRUE, FALSE) AS is_weekend
FROM ${ref("slv_flights")}
WHERE flight_date IS NOT NULL
