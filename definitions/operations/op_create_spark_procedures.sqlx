config {
  type: "operations",
  tags: ["setup", "spark"],
  description: "Creates serverless BigQuery Spark stored procedures that ingest the messy/compressed/nested sources (gzip CSV, nested JSON) into the control (raw) dataset."
}

-- Gzip CSV -> raw_passenger_flow
CREATE OR REPLACE PROCEDURE `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.controlDataset}.sp_load_passenger_flow`(src_uri STRING)
WITH CONNECTION `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.sparkConnection}`
OPTIONS(
  engine="SPARK",
  runtime_version="2.2",
  properties=[("spark.dataproc.lineage.enabled", "true")]
)
LANGUAGE PYTHON AS R"""
import os, json
from pyspark.sql import SparkSession

spark = SparkSession.builder.appName("load_passenger_flow").getOrCreate()
src = json.loads(os.environ["BIGQUERY_PROC_PARAM.src_uri"])

df = (spark.read
      .option("header", True)
      .option("inferSchema", True)
      .csv(src))

(df.write.format("bigquery")
   .option("table", "${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.controlDataset}.raw_passenger_flow")
   .option("writeMethod", "direct")
   .mode("overwrite")
   .save())
""";

-- Nested JSON -> raw_security_wait (exploded to one row per checkpoint reading)
CREATE OR REPLACE PROCEDURE `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.controlDataset}.sp_load_security_wait`(src_uri STRING)
WITH CONNECTION `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.sparkConnection}`
OPTIONS(
  engine="SPARK",
  runtime_version="2.2",
  properties=[("spark.dataproc.lineage.enabled", "true")]
)
LANGUAGE PYTHON AS R"""
import os, json
from pyspark.sql import SparkSession
from pyspark.sql.functions import explode, col

spark = SparkSession.builder.appName("load_security_wait").getOrCreate()
src = json.loads(os.environ["BIGQUERY_PROC_PARAM.src_uri"])

raw = spark.read.option("multiline", True).json(src)
chk = raw.select(col("date").alias("obs_date"), explode(col("checkpoints")).alias("c"))
rdg = chk.select(
    col("obs_date"),
    col("c.checkpoint_id").alias("checkpoint_id"),
    col("c.terminal_id").alias("terminal_id"),
    explode(col("c.readings")).alias("r"),
)
out = rdg.select(
    "obs_date", "checkpoint_id", "terminal_id",
    col("r.ts").alias("reading_ts"),
    col("r.wait_minutes").alias("wait_minutes"),
    col("r.queue_length").alias("queue_length"),
    col("r.lanes_open").alias("lanes_open"),
)

(out.write.format("bigquery")
    .option("table", "${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.controlDataset}.raw_security_wait")
    .option("writeMethod", "direct")
    .mode("overwrite")
    .save())
"""
