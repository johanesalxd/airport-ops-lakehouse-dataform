config {
  type: "operations",
  tags: ["ingestion"],
  dependencies: ["op_create_spark_procedures"],
  description: "Runs the serverless Spark procedure that ingests multilingual customer feedback JSON into the raw control dataset."
}

CALL `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.vars.controlDataset}.sp_load_customer_feedback`(
  'gs://${dataform.projectConfig.vars.rawBucket}/raw/customer_feedback/*/customer_feedback.json'
)
