config {
  type: "table",
  schema: dataform.projectConfig.vars.governanceDataset,
  name: "staff_directory",
  tags: ["security"],
  description: "Self-contained, synthetic airport staff roster used ONLY to demo BigQuery Row-Level Security (RLS) and Column-Level Security (CLS). Nothing in the medallion pipeline reads this table, so the access policies attached to it cannot affect the main flow. All values are fake.",
  assertions: {
    uniqueKey: ["staff_id"],
    nonNull: ["staff_id", "name", "department"]
  },
  columns: {
    staff_id: "Unique identifier for the staff member",
    name: "Full name (public)",
    email: "Work email (CLS: masked with DEFAULT_MASKING_VALUE for non-admins)",
    department: "Department; used for Row-Level Security filtering (Sales group sees only 'Sales')",
    salary: "Annual salary (CLS: masked as NULL for non-admins)",
    ssn: "National ID number (CLS: masked as SHA256 for non-admins)",
    bank_account: "Payroll bank account (CLS: access blocked entirely for non-admins)"
  }
}

SELECT
  staff_id,
  name,
  email,
  department,
  salary,
  ssn,
  bank_account
FROM UNNEST([
  STRUCT('S001' AS staff_id, 'Demo Staff 001' AS name, 'synthetic-staff-001@example.invalid' AS email, 'Sales' AS department, 75000.0 AS salary, '000-00-0001' AS ssn, 'demo-bank-account-001' AS bank_account),
  STRUCT('S002' AS staff_id, 'Demo Staff 002' AS name, 'synthetic-staff-002@example.invalid' AS email, 'Sales' AS department, 68000.0 AS salary, '000-00-0002' AS ssn, 'demo-bank-account-002' AS bank_account),
  STRUCT('S003' AS staff_id, 'Demo Staff 003' AS name, 'synthetic-staff-003@example.invalid' AS email, 'Ground Ops' AS department, 82000.0 AS salary, '000-00-0003' AS ssn, 'demo-bank-account-003' AS bank_account),
  STRUCT('S004' AS staff_id, 'Demo Staff 004' AS name, 'synthetic-staff-004@example.invalid' AS email, 'Ground Ops' AS department, 79000.0 AS salary, '000-00-0004' AS ssn, 'demo-bank-account-004' AS bank_account),
  STRUCT('S005' AS staff_id, 'Demo Staff 005' AS name, 'synthetic-staff-005@example.invalid' AS email, 'Security' AS department, 95000.0 AS salary, '000-00-0005' AS ssn, 'demo-bank-account-005' AS bank_account),
  STRUCT('S006' AS staff_id, 'Demo Staff 006' AS name, 'synthetic-staff-006@example.invalid' AS email, 'Security' AS department, 88000.0 AS salary, '000-00-0006' AS ssn, 'demo-bank-account-006' AS bank_account)
])
