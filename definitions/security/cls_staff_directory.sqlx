config {
  type: "operations",
  name: "cls_staff_directory",
  hasOutput: false,
  tags: ["security"],
  description: "Column-Level Security for staff_directory using the modern SQL-based DATA_POLICY approach (pure Dataform SQLX -- no policy tags / Terraform needed). Dual-policy model per column: a DATA_MASKING_POLICY for general access + a RAW_DATA_ACCESS_POLICY for privileged access, both attached to the column; GRANT FINE_GRAINED_READ decides who gets which. bank_account uses only a raw-access policy, so non-grantees are blocked from the column entirely.",
  dependencies: ["staff_directory"]
}

js {
  const VARS = dataform.projectConfig.vars;
  const { formatClsGrantList } = require("includes/principals");
  // Data policies are regional, addressed as <project>.region-<location>.<name>.
  const policyId = (name) =>
    `${dataform.projectConfig.defaultDatabase}.region-${dataform.projectConfig.defaultLocation}.${name}`;
  const adminGrantTo = formatClsGrantList(VARS.adminMembers, VARS.adminPrincipal);
  const salesGrantTo = formatClsGrantList(VARS.salesMembers, VARS.salesPrincipal);

  const dualPolicyColumns = [
    { column: "ssn", maskingExpression: "SHA256", label: "SHA256" },
    { column: "email", maskingExpression: "DEFAULT_MASKING_VALUE", label: "DEFAULT_MASKING_VALUE" },
    { column: "salary", maskingExpression: "ALWAYS_NULL", label: "ALWAYS_NULL" },
  ];

  const dualPolicySql = dualPolicyColumns
    .map(({ column, maskingExpression, label }) => {
      const maskPolicy = policyId(`staff_${column}_masking_policy`);
      const rawPolicy = policyId(`staff_${column}_raw_policy`);
      return `-- ============================================================
-- ${column} -> ${label} for Sales, raw for Admin
-- ============================================================
CREATE OR REPLACE DATA_POLICY \`${maskPolicy}\`
OPTIONS (data_policy_type="DATA_MASKING_POLICY", masking_expression="${maskingExpression}");

CREATE OR REPLACE DATA_POLICY \`${rawPolicy}\`
OPTIONS (data_policy_type="RAW_DATA_ACCESS_POLICY");

ALTER TABLE ${ref("staff_directory")}
ALTER COLUMN ${column} SET OPTIONS (
  data_policies = [
    "{'name':'${maskPolicy}'}",
    "{'name':'${rawPolicy}'}"
  ]
);

GRANT FINE_GRAINED_READ ON DATA_POLICY \`${maskPolicy}\` TO ${salesGrantTo};
GRANT FINE_GRAINED_READ ON DATA_POLICY \`${rawPolicy}\` TO ${adminGrantTo};`;
    })
    .join("\n\n");
}

${dualPolicySql}

-- ============================================================
-- bank_account -> raw-access only: blocked entirely for non-admins
-- ============================================================
CREATE OR REPLACE DATA_POLICY `${policyId("staff_bank_account_access_policy")}`
OPTIONS (data_policy_type="RAW_DATA_ACCESS_POLICY");

ALTER TABLE ${ref("staff_directory")}
ALTER COLUMN bank_account SET OPTIONS (
  data_policies = ["{'name':'${policyId("staff_bank_account_access_policy")}'}"]
);

GRANT FINE_GRAINED_READ ON DATA_POLICY `${policyId("staff_bank_account_access_policy")}` TO ${adminGrantTo};
