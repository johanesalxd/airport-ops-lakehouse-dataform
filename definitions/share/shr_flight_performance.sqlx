config {
  type: "view",
  schema: dataform.projectConfig.vars.shareDataset,
  tags: ["share"],
  description: "DATA-SHARING PRODUCT (BigQuery Analytics Hub, hub-and-spoke). Curated flight-performance summary by date, terminal, and airline, aggregated from the atomic fct_flight so no raw operational rows are exposed. This view lives in the shareDataset, which is authorized to read the gold/semantic datasets, so subscribers query the product without access to the base tables. Publishing/authorization is handled in the companion demo repo."
}

SELECT
  date_key,
  terminal_id,
  airline_code,
  COUNT(*) AS total_flights,
  SUM(is_delayed) AS delayed_flights,
  ROUND(AVG(is_delayed), 3) AS delay_rate,
  ROUND(AVG(delay_minutes), 1) AS avg_delay_minutes,
  SUM(scheduled_passengers) AS total_scheduled_passengers
FROM ${ref("fct_flight")}
GROUP BY date_key, terminal_id, airline_code
