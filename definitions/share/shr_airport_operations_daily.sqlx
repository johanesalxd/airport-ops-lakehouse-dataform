config {
  type: "view",
  schema: dataform.projectConfig.vars.shareDataset,
  tags: ["share"],
  description: "DATA-SHARING PRODUCT (BigQuery Analytics Hub, hub-and-spoke). Curated, share-safe daily operations KPIs exposed to subscribers via a private Data Exchange listing. This view lives in the shareDataset, which is authorized to read the gold/semantic datasets, so subscribers query the product without access to the base tables. Reads the semantic daily roll-up. Publishing/authorization is handled in the companion demo repo."
}

SELECT
  date_key,
  total_flights,
  delayed_flights,
  delay_rate,
  avg_delay_minutes,
  total_scheduled_passengers,
  total_bags,
  late_bag_rate,
  bags_missing_load_scan
FROM ${ref("sem_airport_operations_daily")}
