config {
  type: "view",
  schema: dataform.projectConfig.vars.bronzeDataset,
  tags: ["bronze"],
  dependencies: ["op_create_ext_customer_feedback"],
  description: "Bronze multilingual customer feedback. A VIEW (not a table) directly over the external JSON landing table, projecting the single native JSON column to typed columns at read time. Intentionally non-materialised -- an anti-pattern for serving (re-reads + re-parses external row-oriented JSON on every query); a production design would materialise this as a native/columnar table.",
  assertions: { nonNull: ["feedback_id"] }
}

SELECT
  JSON_VALUE(payload.feedback_id) AS feedback_id,
  JSON_VALUE(payload.terminal_id) AS terminal_id,
  SAFE_CAST(JSON_VALUE(payload.submitted_ts) AS TIMESTAMP) AS submitted_ts,
  JSON_VALUE(payload.source_language) AS source_language,
  JSON_VALUE(payload.feedback_text) AS feedback_text,
  INT64(payload.rating) AS rating,
  payload,  -- passthrough of the raw native JSON value (queryable directly, e.g. payload.feedback_text)
  '${dataform.projectConfig.vars.batchId}' AS _batch_id,
  'customer_feedback.jsonl' AS _source_file,
  'JSON_EXTERNAL' AS _source_format,
  CURRENT_TIMESTAMP() AS _ingested_at,
  TO_HEX(MD5(TO_JSON_STRING(payload))) AS _record_hash
FROM ${ref("raw_customer_feedback")}
